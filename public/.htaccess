Options -Indexes
ServerSignature Off
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # React v3 SPA entry. Apache can otherwise treat /app/ as a directory and
    # return 403 when directory indexes are restricted. Always serve the
    # authenticated React entry gate for the SPA root; hash routes such as
    # /app/#/threats are handled client-side and are never sent to Apache.
    RewriteRule ^app/?$ app/index.php [END]

    # Never expose common reconnaissance targets, even if one is accidentally
    # copied into the public directory. Route them to the telemetry endpoint,
    # which records the probe and deliberately returns 404.
    RewriteRule ^(\.env(?:\..*)?|\.git(?:/.*)?|composer\.(?:json|lock)|phpinfo\.php|server-status|adminer\.php|phpmyadmin(?:/.*)?|wp-admin(?:/.*)?|wp-login\.php|vendor(?:/.*)?|.*\.(?:bak|old|orig|save|swp|sql|sqlite|zip|tar|tgz|gz|7z))$ security_probe.php?probe=/$1 [END,NE,NC]

    # Treat other hidden-file/directory requests as reconnaissance too instead
    # of exposing whether the target exists.
    RewriteRule ^((?:.*/)?\..*)$ security_probe.php?probe=/$1 [END,NE,NC]

    # Full unknown-path reconnaissance capture. Real files/directories are left
    # alone; everything else is logged and receives the same generic 404.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ security_probe.php?probe=/$1 [END,NE]
</IfModule>

# Fallback coverage if a request reaches Apache's native error handling.
ErrorDocument 404 /security_probe.php
ErrorDocument 403 /security_probe.php

<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|README.*|HARDENING_NOTES\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/app/assets/" fortress_v3_hashed_asset=1
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Cache-Control "public, max-age=31536000, immutable" env=fortress_v3_hashed_asset
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=!fortress_v3_hashed_asset
</IfModule>
