# FortressAuth local/deployment configuration
APP_ENV=production

DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=fortressauth
DB_USER=fortress_user
DB_PASS=replace-with-a-new-strong-password
DB_SSLMODE=require

# Set true only when FortressAuth is actually behind a trusted reverse proxy
# such as Render. Never enable this on an untrusted direct deployment.
TRUST_PROXY_HEADERS=true

# Production HTTPS should use secure cookies. For local HTTP development only,
# set COOKIE_SECURE=false in your private .env file.
COOKIE_SECURE=true

# Optional session controls
SESSION_IDLE_TIMEOUT=900
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_BIND_USER_AGENT=true

# Keep the pentest crown-jewel flag out of source control.
FORTRESS_VAULT_FLAG=replace-with-a-private-course-flag

# Optional hybrid ML threat engine. FortressAuth remains fully functional when disabled/unavailable.
ML_SERVICE_ENABLED=false
ML_SERVICE_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=400
# Strongly recommended whenever the ML service is reachable over a network.
ML_SERVICE_TOKEN=replace-with-a-random-private-token
ML_MIN_LOG_RISK=30
